# Скопируйте значения в /etc/grants-lead/telegram.env на сервере.
# Не добавляйте реальные значения в Git и не отправляйте их в чат.
BOT_TOKEN=replace_with_botfather_token
CHAT_ID=replace_with_destination_chat_id
# Если api.telegram.org недоступен с VPS, используйте защищённый relay.
TELEGRAM_RELAY_URL=https://grants-lead.derezaivan.workers.dev/
TELEGRAM_RELAY_KEY=replace_with_random_relay_key
